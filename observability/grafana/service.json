{
  "uid": "duvo-service",
  "title": "Duvo service",
  "tags": ["duvo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Requests / s by route",
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
     "targets": [{"refId": "A", "legendFormat": "{{route}}",
       "expr": "sum by (route) (rate(http_requests_total{job=\"duvo-api\",route!~\"/healthz|/readyz|/metrics\"}[1m]))"}]},
    {"id": 2, "type": "timeseries", "title": "5xx error ratio (SLO budget line 0.5%)",
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
     "targets": [
       {"refId": "A", "legendFormat": "error ratio", "expr": "slo:api_errors:ratio_rate5m"},
       {"refId": "B", "legendFormat": "SLO threshold", "expr": "vector(0.005)"}]},
    {"id": 3, "type": "timeseries", "title": "Latency p50 / p95 / p99",
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
     "targets": [
       {"refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"duvo-api\",route!~\"/healthz|/readyz|/metrics\"}[1m])))"},
       {"refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"duvo-api\",route!~\"/healthz|/readyz|/metrics\"}[1m])))"},
       {"refId": "C", "legendFormat": "p99", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"duvo-api\",route!~\"/healthz|/readyz|/metrics\"}[1m])))"}]},
    {"id": 4, "type": "timeseries", "title": "Jobs / s by outcome",
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
     "targets": [{"refId": "A", "legendFormat": "{{outcome}}",
       "expr": "sum by (outcome) (rate(jobs_total[1m]))"}]},
    {"id": 5, "type": "stat", "title": "Queue depth",
     "gridPos": {"h": 4, "w": 6, "x": 0, "y": 16},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "max(queue_depth)"}]},
    {"id": 6, "type": "stat", "title": "Job p95 duration",
     "gridPos": {"h": 4, "w": 6, "x": 6, "y": 16},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(job_duration_seconds_bucket[5m])))"}]},
    {"id": 7, "type": "stat", "title": "Firing alerts",
     "gridPos": {"h": 4, "w": 6, "x": 12, "y": 16},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)"}]},
    {"id": 8, "type": "stat", "title": "Targets up",
     "gridPos": {"h": 4, "w": 6, "x": 18, "y": 16},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum(up{job=~\"duvo-.*\"})"}]},
    {"id": 9, "type": "logs", "title": "Logs (api + worker)",
     "gridPos": {"h": 10, "w": 24, "x": 0, "y": 20},
     "datasource": {"type": "loki", "uid": "loki"},
     "targets": [{"refId": "A", "expr": "{service_name=~\"duvo-api|duvo-worker\"}"}]}
  ]
}
